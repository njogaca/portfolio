# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender in Resend (optional; falls back to onboarding@resend.dev)
# CONTACT_FROM_EMAIL="Portfolio Contact <contact@johangarcia.dev>"

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
